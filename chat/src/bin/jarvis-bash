#!/usr/bin/env -S node --disable-warning=ExperimentalWarning
// claw's bash tool (CLAW_BASH_COMMAND): reads the tool input JSON on stdin, runs it in the conversation's sandbox
// and prints {stdout, stderr, exit_code, interrupted, background_task_id?} as JSON (src/web/bash.ts).
// The turn runner sets JARVIS_SANDBOX_SOCKET (its unix socket), JARVIS_TURN_TOKEN and JARVIS_SYNC_STATE; the
// sandbox is asked for there on every call and made at the first one (docs/CHAT.md, "Sandbox lifecycle"). The
// workdir is the current directory.
import { requestSandbox, RESET_NOTE, runBash } from "../web/bash.ts";

const chunks = [];
for await (const c of process.stdin) chunks.push(c);
let input;
try {
  input = JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}");
} catch {
  process.stderr.write("bash: the input is not JSON\n");
  process.exit(2);
}
const unavailable = (why) => {
  // no sandbox for this command: say why in plain words (the model passes this on; no internal names)
  process.stderr.write(`The sandbox is not available for this message (${why || "it could not be started"}). Try again in a minute.\n`);
  process.exit(2);
};
const socket = process.env.JARVIS_SANDBOX_SOCKET;
const statePath = process.env.JARVIS_SYNC_STATE;
if (!socket || !statePath) unavailable("");
let grant;
try {
  grant = await requestSandbox(socket, process.env.JARVIS_TURN_TOKEN || "");
} catch {
  unavailable("");
}
if (grant.unavailable) unavailable(grant.unavailable);
try {
  const out = await runBash(input, { workdir: process.cwd(), sandboxUrl: grant.url, sandboxToken: grant.token, sandboxId: grant.id, statePath, sandboxHeaders: grant.headers });
  // a new sandbox replaced the conversation's earlier one: the model hears it once, with this command's output
  if (grant.reset) out.stdout = `${RESET_NOTE}\n${out.stdout}`;
  // the command ended: the sandbox was used now (its idle release counts from here)
  await requestSandbox(socket, process.env.JARVIS_TURN_TOKEN || "", 10_000, "/sandbox/used").catch(() => {});
  process.stdout.write(JSON.stringify(out) + "\n");
} catch (e) {
  process.stderr.write(`The sandbox did not answer (${e instanceof Error ? e.message : e}). It will be restarted for the next message.\n`);
  process.exit(1);
}
