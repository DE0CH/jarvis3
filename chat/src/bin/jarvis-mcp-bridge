#!/usr/bin/env node
// claw's MCP server "tools" (a stdio server in its config) → the tools role over HTTP (docs/CHAT.md).
// stdio side: JSON-RPC framed with Content-Length headers (claw's MCP client) or one JSON message per line; answers go
// back in the framing the first message used. HTTP side: POST $JARVIS_TOOLS_URL, Authorization: Bearer
// $JARVIS_TURN_TOKEN, JSON or text/event-stream answers. Requests run concurrently; answers keep their ids.
import { createHash } from "node:crypto";
import { createReadStream } from "node:fs";
import { lstat, realpath } from "node:fs/promises";
import { join, relative, sep } from "node:path";

const URL_ = process.env.JARVIS_TOOLS_URL;
// the conversation's workdir (present_files paths are checked here); claw starts this bridge in it too
const WORKDIR = process.env.JARVIS_WORKDIR || process.cwd();
// never stored or shown (chat/src/web/workspace.ts: EXCLUDED_DIRS, MAX_FILE_BYTES)
const EXCLUDED = new Set(["node_modules", ".venv", "venv", "__pycache__", ".cache", ".claw", ".jobs"]);
const MAX_FILE_BYTES = 50 * 1024 * 1024;
const TOKEN = process.env.JARVIS_TURN_TOKEN;
if (!URL_ || !TOKEN) {
  process.stderr.write("jarvis-mcp-bridge: JARVIS_TOOLS_URL and JARVIS_TURN_TOKEN must be set\n");
  process.exit(2);
}

let framing = null; // "headers" | "lines"
let buf = Buffer.alloc(0);
let pending = 0;
let ended = false;

function write(msg) {
  const body = Buffer.from(JSON.stringify(msg), "utf8");
  if (framing === "lines") process.stdout.write(Buffer.concat([body, Buffer.from("\n")]));
  else process.stdout.write(Buffer.concat([Buffer.from(`Content-Length: ${body.length}\r\n\r\n`), body]));
}

function pickAnswers(body, contentType) {
  if (!body.trim()) return [];
  if (contentType.includes("text/event-stream")) {
    const out = [];
    for (const block of body.split(/\r?\n\r?\n/)) {
      const data = block.split(/\r?\n/).filter((l) => l.startsWith("data:")).map((l) => l.slice(5).replace(/^ /, "")).join("\n");
      if (!data) continue;
      try {
        const m = JSON.parse(data);
        out.push(...(Array.isArray(m) ? m : [m]));
      } catch {}
    }
    return out;
  }
  const m = JSON.parse(body);
  return Array.isArray(m) ? m : [m];
}

function sha256(path) {
  return new Promise((ok, fail) => {
    const h = createHash("sha256");
    createReadStream(path).on("data", (c) => h.update(c)).on("end", () => ok(h.digest("hex"))).on("error", fail);
  });
}

/**
 * What one present_files path is in the workspace: {path, size, sha256} (path relative to the workdir) or {error}.
 * A sandbox path (/work/x) or an absolute path inside the workdir is made relative; nothing outside it is accepted.
 */
async function fileFact(given, workdir = WORKDIR) {
  let p = String(given ?? "").trim();
  if (!p) return { error: "empty path" };
  if (p.startsWith("/work/")) p = p.slice(6);
  else if (p.startsWith(workdir + "/")) p = p.slice(workdir.length + 1);
  p = p.replace(/^(\.\/)+/, "").replace(/\/+/g, "/");
  if (p.startsWith("/") || p.split("/").some((x) => x === ".." || x === "")) return { error: "not a path inside the workspace" };
  const parts = p.split("/");
  if (parts.slice(0, -1).some((x) => EXCLUDED.has(x)) || (parts[0] === ".git" && parts[1] === "objects")) return { error: "files in that folder are not kept, so they can't be shown; copy it elsewhere in the workspace first" };
  const abs = join(workdir, p);
  const st = await lstat(abs).catch(() => null);
  if (!st) return { error: "no such file in the workspace (files written in the sandbox under /work appear here after the bash command that wrote them)" };
  if (st.isSymbolicLink()) return { error: "a symbolic link; give the file itself" };
  if (!st.isFile()) return { error: "not a file" };
  const real = await realpath(abs).catch(() => abs);
  const root = await realpath(workdir).catch(() => workdir);
  if (relative(root, real).split(sep)[0] === "..") return { error: "not a path inside the workspace" };
  if (st.size > MAX_FILE_BYTES) return { error: "larger than 50 MB, too large to keep or download" };
  return { path: p, size: st.size, sha256: await sha256(abs) };
}

/** present_files: the tools role can't see the workspace, so the facts travel in the call's _meta. */
async function annotate(msg) {
  if (!msg || msg.method !== "tools/call" || msg.params?.name !== "present_files") return msg;
  // the same leniency as the tool (chat/src/tools/present.ts filesArg): a JSON string, one object, plain paths
  let files = msg.params?.arguments?.files;
  if (typeof files === "string") {
    try {
      files = JSON.parse(files);
    } catch {
      files = [files];
    }
  }
  if (files && typeof files === "object" && !Array.isArray(files)) files = [files];
  if (!Array.isArray(files)) files = [];
  const facts = {};
  for (const f of files.slice(0, 50)) {
    const p = typeof f === "string" ? f : f && typeof f === "object" ? f.path : undefined;
    if (typeof p === "string" && !(p in facts)) facts[p] = await fileFact(p).catch((e) => ({ error: String(e?.message ?? e) }));
  }
  return { ...msg, params: { ...msg.params, _meta: { ...(msg.params._meta ?? {}), "jarvis/files": facts } } };
}

async function forward(msg) {
  msg = await annotate(msg);
  const isRequest = msg && typeof msg === "object" && "id" in msg && msg.id !== null && typeof msg.method === "string";
  pending++;
  try {
    let lastErr = null;
    for (let attempt = 0; attempt < 4; attempt++) {
      try {
        const r = await fetch(URL_, {
          method: "POST",
          headers: { authorization: `Bearer ${TOKEN}`, "content-type": "application/json", accept: "application/json, text/event-stream", "mcp-protocol-version": "2025-06-18" },
          body: JSON.stringify(msg),
        });
        const text = await r.text();
        if (r.status === 503 && attempt < 3) {
          await new Promise((ok) => setTimeout(ok, 500 * (attempt + 1)));
          continue;
        }
        if (!r.ok && r.status !== 202) throw new Error(`tools server answered HTTP ${r.status}: ${text.slice(0, 200)}`);
        for (const a of pickAnswers(text, r.headers.get("content-type") || "")) write(a);
        return;
      } catch (e) {
        lastErr = e;
        if (attempt < 3) await new Promise((ok) => setTimeout(ok, 500 * (attempt + 1)));
      }
    }
    if (isRequest) write({ jsonrpc: "2.0", id: msg.id, error: { code: -32603, message: `jarvis-mcp-bridge: ${lastErr?.message ?? "failed"}` } });
  } finally {
    pending--;
    if (ended && pending === 0) process.exit(0);
  }
}

function handle(raw) {
  let msg;
  try {
    msg = JSON.parse(raw);
  } catch {
    write({ jsonrpc: "2.0", id: null, error: { code: -32700, message: "parse error" } });
    return;
  }
  void forward(msg);
}

function pump() {
  for (;;) {
    if (!framing) {
      const s = buf.toString("utf8", 0, Math.min(buf.length, 32)).trimStart();
      if (!s) return;
      framing = /^content-length/i.test(s) ? "headers" : s.startsWith("{") || s.startsWith("[") ? "lines" : null;
      if (!framing) {
        if (buf.length < 16) return;
        framing = "lines";
      }
    }
    if (framing === "lines") {
      const i = buf.indexOf(10);
      if (i < 0) return;
      const line = buf.subarray(0, i).toString("utf8").trim();
      buf = buf.subarray(i + 1);
      if (line) handle(line);
      continue;
    }
    const end = buf.indexOf("\r\n\r\n");
    if (end < 0) return;
    const head = buf.subarray(0, end).toString("utf8");
    const m = /content-length:\s*(\d+)/i.exec(head);
    if (!m) {
      buf = buf.subarray(end + 4);
      continue;
    }
    const len = Number(m[1]);
    if (buf.length < end + 4 + len) return;
    const body = buf.subarray(end + 4, end + 4 + len).toString("utf8");
    buf = buf.subarray(end + 4 + len);
    handle(body);
  }
}

process.stdin.on("data", (c) => {
  buf = Buffer.concat([buf, c]);
  pump();
});
process.stdin.on("end", () => {
  ended = true;
  if (pending === 0) process.exit(0);
});
