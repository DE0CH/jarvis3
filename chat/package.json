{
  "name": "@jarvis3/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jarvis 3 chat runtime: web (UI, API, turn runner, sandbox manager), egress proxy, tools (MCP)",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run typecheck && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
